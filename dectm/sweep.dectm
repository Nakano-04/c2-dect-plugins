# scope: lab-only
# mitre: T1082, T1057, T1016
# sweep.dectm — ejemplo v1: barrido rectilíneo (sin ramas: para condicionales
# usa Lua a mano, p.ej. scripts/lua/dect-lethal-script.lua).
name: dect-lethal-sweep
version: 1.0.0
scope: lab-only
mitre: [T1082, T1057, T1016]
sign: null
defaults:
  timeout: 30
reruns: 1
steps:
  - {name: sys, task: sysinfo}
  - {name: procs, task: ps}
  - {name: who, exec: whoami, timeout: 10}
  - {name: nets, task: netinfo, requires: [sys]}
  - {name: snap, kv.set: sweep:last-run, value: done}
